{
  "name": "solarcards",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Zwei Home-Assistant-Lovelace-Karten für Solaranlagen: Solarerzeugung als Balkendiagramm mit Prognose (PV Energy Diagram) und Energiefluss (PV/Speicher/Netz) als Ring-/Sankey-Diagramm (PV Energy Flow Card), inkl. optionaler Kostenanzeige.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "serve": "http-server dist --port 5000 --cors -c-1",
    "start": "concurrently -k \"npm:dev\" \"npm:serve\"",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "http-server": "^14.1.1",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.0"
  }
}
